# PhysioCare web - skopiuj do .env.local
# Windows: Copy-Item .env.example .env.local
# Linux/macOS: cp .env.example .env.local
#
# Wartości VITE_* są publiczne i trafiają do bundla przeglądarki.
# Nigdy nie dodawaj tutaj RECAPTCHA_SECRET_KEY ani innych sekretów backendu.
# VITE_API_BASE_URL=http://localhost:8000/api/v1
#
# Puste = żądania względne /api/v1 (proxy Vite w dev).
VITE_API_BASE_URL=

# Google Sign-In (Web Client ID z Google Cloud Console; ten sam w GOOGLE_CLIENT_IDS na backendzie)
# VITE_GOOGLE_CLIENT_ID=WKLEJ_TUTAJ_GOOGLE_WEB_CLIENT_ID

# Google reCAPTCHA:
# Site Key pobierz z Google reCAPTCHA Admin Console.
# Jest publiczny i może być używany w aplikacji webowej.
VITE_RECAPTCHA_SITE_KEY=WKLEJ_TUTAJ_RECAPTCHA_SITE_KEY
