# =============================================================================
# PhysioCare - szablon zmiennych środowiskowych
# Skopiuj: Copy-Item .env.example .env   (Windows)
#          cp .env.example .env          (Linux/macOS)
# Uzupełnij .env własnymi wartościami - ten plik commitujemy BEZ sekretów.
# =============================================================================

# --- Django / Backend ---
DJANGO_SECRET_KEY=your-secret-key-here
# Lokalnie: true. Na każdym publicznym hoście MUSI być false.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.45
# Lokalnie: false. Na HTTPS / publicznym hoście: true.
DJANGO_SECURE_COOKIES=false
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_PROXY_SSL_HEADER=true
DJANGO_USE_X_FORWARDED_HOST=true
DJANGO_HSTS_SECONDS=31536000
# Demo/publiczny host: false (ukrywa /admin/). Albo zostaw true + allowlist IP.
DJANGO_ADMIN_ENABLED=true
# Puste = bez filtra IP. Przykład: DJANGO_ADMIN_ALLOWED_IPS=127.0.0.1,203.0.113.10
DJANGO_ADMIN_ALLOWED_IPS=
API_BASE_URL=http://localhost:8000/api/v1

# --- PostgreSQL ---
POSTGRES_DB=your-db-name
POSTGRES_USER=your-db-user
POSTGRES_PASSWORD=your-db-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_TEST_DB=your-db-name
# Opcjonalnie (scripts/setup_postgres_auth.py) - superuser z instalacji EDB:
# POSTGRES_ADMIN_USER=postgres
# POSTGRES_ADMIN_PASSWORD=your-postgres-superuser-password
# Klucz szyfrowania danych at-rest (Fernet AES-128-CBC + HMAC SHA-256): 32 url-safe base64 bytes
FIELD_ENCRYPTION_KEY=
DATABASE_URL=postgres://your-db-user:your-db-password@localhost:5432/your-db-name
DB_CONN_MAX_AGE=0
DB_SSLMODE=prefer

# --- JWT ---
JWT_ACCESS_LIFETIME_MIN=15
JWT_REFRESH_LIFETIME_DAYS=7

# --- Google Sign-In (opcjonalnie) ---
# Client ID (Web + Android/iOS), przecinkami - audience ID tokena.
# Web client: Authorized JavaScript origins + Authorized redirect URIs
#   np. http://localhost:5173 (i http://127.0.0.1:5173 jeśli używasz tego hosta)
# Ten sam Web Client ID → VITE_GOOGLE_CLIENT_ID / EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID
# GOOGLE_CLIENT_IDS=123456789-abc.apps.googleusercontent.com,123456789-android.apps.googleusercontent.com

# --- Bot Protection (Google reCAPTCHA v2 / v3) ---
# RECAPTCHA_ENABLED=false
# RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
# RECAPTCHA_SCORE_THRESHOLD=0.5

# --- Rate limiting ---
THROTTLE_ANON=60/minute
THROTTLE_USER=300/minute
THROTTLE_LOGIN=5/minute
THROTTLE_REGISTER=3/hour
THROTTLE_PASSWORD_RESET=3/hour
# Przy wielu workerach Gunicorn ustaw Redis - inaczej limity są per-proces (LocMem):
REDIS_URL=redis://127.0.0.1:6379/1

# --- Pliki ---
MEDIA_ROOT=backend/media
MAX_UPLOAD_MB=50
MAX_AVATAR_MB=5
# UWAGA: /media/ jest zawsze za JWT + ownership (nie serwuj volume publicznie z nginx).

# --- CORS (web + expo dev) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8081

# --- E-mail (weryfikacja konta + reset hasła - kod 6 cyfr) ---
# Lokalnie bez SMTP: console (treść w logu Django).
# Praca inżynierska / demo: Gmail SMTP + hasło aplikacji (bez domeny, 0 zł):
#   1) Google Konto → Bezpieczeństwo → Weryfikacja dwuetapowa → Hasła aplikacji
#   2) EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#      EMAIL_HOST=smtp.gmail.com  EMAIL_PORT=587  EMAIL_USE_TLS=true
#      EMAIL_HOST_USER=twoj.gmail@gmail.com
#      EMAIL_HOST_PASSWORD=<16-znakowe-haslo-aplikacji>
#      EMAIL_FROM=PhysioCare <twoj.gmail@gmail.com>
# Później (produkcja z domeną): ten sam EMAIL_* z Resend/Brevo - bez zmiany logiki OTP.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_FROM=PhysioCare <noreply@example.com>
# TTL kodu e-mail (weryfikacja + reset hasła) oraz tokenu po verify, sekundy (domyślnie 30 min)
PASSWORD_RESET_TIMEOUT=1800
EMAIL_CODE_MAX_ATTEMPTS=5
FRONTEND_URL=http://localhost:5173

# --- Powiadomienia (Expo Push; bez tokenu - e-mail) ---
# EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
# EXPO_PUSH_TIMEOUT=10
# Osobny proces: python manage.py run_notification_scheduler
# NOTIFICATION_SCHEDULER_INTERVAL_SECONDS=900
# SSE (/api/v1/me/events/) - heartbeat w sekundach; SSE_MAX_FRAMES tylko do testów (0 = bez limitu)
# SSE_HEARTBEAT_SECONDS=20
# SSE_MAX_FRAMES=0
# Szyna zdarzeń SSE: auto (używa Redisa gdy REDIS_URL jest ustawiony), redis, lub inmemory
# SSE_BUS_ENGINE=auto
# SSE_REDIS_CHANNEL_PREFIX=physiocare:sse:

# --- Monitoring / logi / alerting ---
# text | json  (domyślnie: text przy DJANGO_DEBUG=true, json w produkcji)
LOG_FORMAT=text
# Produkcja: ustaw DSN Sentry (5xx + wyjątki → alerty)
# SENTRY_DSN=https://...@o....ingest.sentry.io/...
# SENTRY_ENVIRONMENT=staging
# SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Web (Vite) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
# OAuth 2.0 Client ID typu Web application (Google Cloud Console)
# VITE_GOOGLE_CLIENT_ID=123456789-abc.apps.googleusercontent.com
# VITE_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI

# --- Mobile (Expo) ---
# Produkcja: native build (EAS). Expo web trzyma JWT w localStorage - tylko dev.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# Web Client ID (wymagany do ID token). Opcjonalnie osobne iOS/Android Client ID:
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=123456789-abc.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# =============================================================================
# Checklist produkcji / publicznego demo (skrót)
# - DJANGO_DEBUG=false
# - DJANGO_SECURE_COOKIES=true, DJANGO_SECURE_SSL_REDIRECT=true, DJANGO_SECURE_PROXY_SSL_HEADER=true
# - DB_SSLMODE=require (dla zewnętrznych baz produkcyjnych)
# - DJANGO_ADMIN_ENABLED=false LUB DJANGO_ADMIN_ALLOWED_IPS=<twoje IP>
# - REDIS_URL przy WEB_CONCURRENCY > 1
# - SENTRY_DSN ustawione
# - Nginx: NIE aliasuj /media na dysk - tylko proxy do Gunicorn
# =============================================================================
