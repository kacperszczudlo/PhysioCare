# =============================================================================
# PhysioCare - .gitignore
# =============================================================================

# --- Secrets / env ---
.env
.env.*
!.env.example
!**/.env.example

# Personal Postman environments (tokens / prawdziwe hasla)
*.local.postman_environment.json
.postman/local/

# --- Python / Django ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
*.egg
.venv/
venv/
env/
local_settings.py
backend/media/
backend/staticfiles/
*.sqlite3
*.sqlite3-journal
backend/physiocare/db.sqlite3

# --- Test / coverage (generowane lokalnie) ---
backend/reports/
.coverage
.coverage.*
coverage.xml
htmlcov/
.pytest_cache/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.hypothesis/
pytest-cache-files-*/
**/reports/coverage/
**/reports/pytest-report.html
backend/.coverage
backend/.pytest_cache/

# --- Node / React / Expo ---
node_modules/
dist/
build/
.expo/
.expo-shared/
web-build/
.turbo/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- IDE / OS / Windows ---
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Certs / keys (nie commituj) ---
*.pem
*.p12
*.pfx
id_rsa
id_rsa.pub
*.keystore

# --- Misc tooling ---
*.bak
*.tmp
.direnv/
.python-version.local

docs/cheat-sheet.md
cheat-sheet.md
*cheat-sheet*.md
