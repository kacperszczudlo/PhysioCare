# API backend (trailing slash optional - client normalizes)
# Emulator Android: http://10.0.2.2:8000/api/v1
# Expo Go (telefon w LAN): http://<IP-komputera>:8000/api/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
EXPO_PUBLIC_EAS_PROJECT_ID=

# Google Sign-In (ID token). Web Client ID + opcjonalnie iOS/Android.
# Te same ID muszą być na liście GOOGLE_CLIENT_IDS w backendzie.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=123456789-abc.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
