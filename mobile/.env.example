# PhysioCare mobile - skopiuj do .env
# Windows: Copy-Item .env.example .env
# Linux/macOS: cp .env.example .env
#
# API backend (końcowy slash jest opcjonalny - klient go normalizuje).
# Emulator Android Studio: http://10.0.2.2:8000/api/v1
# Telefon fizyczny w tej samej sieci: http://<IP-komputera>:8000/api/v1
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000/api/v1

# Google reCAPTCHA:
# Site Key pobierz z Google reCAPTCHA Admin Console.
# To jest klucz publiczny i może znajdować się w aplikacji mobilnej.
EXPO_PUBLIC_RECAPTCHA_SITE_KEY=WKLEJ_TUTAJ_RECAPTCHA_SITE_KEY
# Adres strony bazowej używany przez komponent CAPTCHA.
EXPO_PUBLIC_RECAPTCHA_BASE_URL=http://localhost

# Identyfikator projektu Expo/EAS.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Google Sign-In (ID token). Web Client ID + opcjonalnie iOS/Android.
# Te same ID muszą być na liście GOOGLE_CLIENT_IDS w backendzie.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=WKLEJ_TUTAJ_GOOGLE_WEB_CLIENT_ID
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=WKLEJ_TUTAJ_GOOGLE_ANDROID_CLIENT_ID

# Nie dodawaj tutaj RECAPTCHA_SECRET_KEY.
# Sekret CAPTCHA należy wyłącznie do głównego .env backendu.
