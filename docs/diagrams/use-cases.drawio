        <mxCell id="actor_system" value="System&#xa;(powiadomienia)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1240" y="500" width="40" height="80" as="geometry"/>
